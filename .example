# Configuration API
API_ADDR=:3000
# Préfixe partagé par toutes les routes API (valeur par défaut : /v1)
API_PREFIX=/v1

# Taux d'achat/vente et variation affichés sur le tableau de bord (GET /analysais)
EXCHANGE_RATE_USD_CDF_BUY=2263.3300
EXCHANGE_RATE_USD_CDF_SELL=2795.0000
EXCHANGE_RATE_USD_CDF_CHANGE=-0.16
EXCHANGE_RATE_EUR_CDF_BUY=2542.8200
EXCHANGE_RATE_EUR_CDF_SELL=2542.8200
EXCHANGE_RATE_EUR_CDF_CHANGE=0.12
EXCHANGE_RATE_GBP_CDF_BUY=3048.0900
EXCHANGE_RATE_GBP_CDF_SELL=3048.0900
EXCHANGE_RATE_GBP_CDF_CHANGE=0.2

# Configuration PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=fx_drc_db

# Configuration SSL PostgreSQL (CRITIQUE pour la sécurité)
# Options valides: disable, allow, prefer, require, verify-ca, verify-full
# - Développement local: 'prefer' ou 'require'
# - Production: 'require' ou 'verify-full' (recommandé)
# - JAMAIS 'disable' ou 'allow' en production
DB_SSLMODE=prefer
# Required when Twilio/SMTP credentials are saved in notification settings.
# Generate with: openssl rand -base64 32
NOTIFICATION_SETTINGS_ENCRYPTION_KEY=

# Clés JWT - CHOISIR UNE DES OPTIONS CI-DESSOUS

# Option 1: Variables d'environnement base64 (Recommandé pour la production)
# JWT_PRIVATE_KEY="base64_encoded_private_key_here"
# JWT_PUBLIC_KEY="base64_encoded_public_key_here"

# Option 2: Chemins vers fichiers de clés
# JWT_PRIVATE_KEY_PATH="/chemin/vers/private.pem"
# JWT_PUBLIC_KEY_PATH="/chemin/vers/public.pem"

# Option 3: Utiliser les emplacements par défaut (jwt/private.pem, jwt/public.pem)
# DÉCONSEILLÉ EN PRODUCTION

# Configuration de sécurité
# JWT_EXPIRATION_HOURS=24
# MAX_LOGIN_ATTEMPTS=5
# ACCOUNT_LOCKOUT_MINUTES=30

# Logging
# LOG_LEVEL=info
# LOG_FORMAT=json

# Pour générer de nouvelles clés JWT:
# ./scripts/generate_jwt_keys.sh

# Bootstrap du premier administrateur si aucun ADMIN actif n'existe
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password
